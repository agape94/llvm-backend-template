From 2b41743e6be4436c1978eff8af5c0ba55bdadeb8 Mon Sep 17 00:00:00 2001
From: "Agape, Alexandru" <alexandru.agape@student.tugraz.at>
Date: Fri, 13 Oct 2023 17:15:38 +0200
Subject: [PATCH] Add "Simple" target into the LLVM environment

---
 llvm/include/llvm/BinaryFormat/ELF.h                |  6 ++++++
 llvm/include/llvm/BinaryFormat/ELFRelocs/Simple.def |  7 +++++++
 llvm/include/llvm/Object/ELFObjectFile.h            |  4 ++++
 llvm/include/llvm/TargetParser/Triple.h             |  8 +++++++-
 llvm/lib/BinaryFormat/ELF.cpp                       |  3 +++
 llvm/lib/Object/ELF.cpp                             |  9 +++++++++
 llvm/lib/Object/RelocationResolver.cpp              | 13 +++++++++++++
 llvm/lib/ObjectYAML/ELFYAML.cpp                     |  4 ++++
 llvm/lib/TargetParser/Triple.cpp                    |  9 +++++++++
 9 files changed, 62 insertions(+), 1 deletion(-)
 create mode 100644 llvm/include/llvm/BinaryFormat/ELFRelocs/Simple.def

diff --git a/llvm/include/llvm/BinaryFormat/ELF.h b/llvm/include/llvm/BinaryFormat/ELF.h
index f5a7cdb387..31b8eefbbc 100644
--- a/llvm/include/llvm/BinaryFormat/ELF.h
+++ b/llvm/include/llvm/BinaryFormat/ELF.h
@@ -320,6 +320,7 @@ enum {
   EM_VE = 251,            // NEC SX-Aurora VE
   EM_CSKY = 252,          // C-SKY 32-bit processor
   EM_LOONGARCH = 258,     // LoongArch
+  EM_SIMPLE = 300,
 };
 
 // Object file classes.
@@ -665,6 +666,11 @@ enum {
 #include "ELFRelocs/Lanai.def"
 };
 
+// ELF Relocation type for Simple.
+enum {
+#include "ELFRelocs/Simple.def"
+};
+
 // RISCV Specific e_flags
 enum : unsigned {
   EF_RISCV_RVC = 0x0001,
diff --git a/llvm/include/llvm/BinaryFormat/ELFRelocs/Simple.def b/llvm/include/llvm/BinaryFormat/ELFRelocs/Simple.def
new file mode 100644
index 0000000000..7a3136372f
--- /dev/null
+++ b/llvm/include/llvm/BinaryFormat/ELFRelocs/Simple.def
@@ -0,0 +1,7 @@
+
+#ifndef ELF_RELOC
+#error "ELF_RELOC must be defined"
+#endif
+
+// No relocation
+ELF_RELOC(R_SIMPLE_NONE,        0)
diff --git a/llvm/include/llvm/Object/ELFObjectFile.h b/llvm/include/llvm/Object/ELFObjectFile.h
index f3016cc141..07570c528b 100644
--- a/llvm/include/llvm/Object/ELFObjectFile.h
+++ b/llvm/include/llvm/Object/ELFObjectFile.h
@@ -1206,6 +1206,8 @@ StringRef ELFObjectFile<ELFT>::getFileFormatName() const {
       return "elf32-hexagon";
     case ELF::EM_LANAI:
       return "elf32-lanai";
+    case ELF::EM_SIMPLE:
+      return "elf32-simple";
     case ELF::EM_MIPS:
       return "elf32-mips";
     case ELF::EM_MSP430:
@@ -1283,6 +1285,8 @@ template <class ELFT> Triple::ArchType ELFObjectFile<ELFT>::getArch() const {
     return Triple::hexagon;
   case ELF::EM_LANAI:
     return Triple::lanai;
+  case ELF::EM_SIMPLE:
+    return Triple::simple;
   case ELF::EM_MIPS:
     switch (EF.getHeader().e_ident[ELF::EI_CLASS]) {
     case ELF::ELFCLASS32:
diff --git a/llvm/include/llvm/TargetParser/Triple.h b/llvm/include/llvm/TargetParser/Triple.h
index 79ccd644a5..89c3e3e361 100644
--- a/llvm/include/llvm/TargetParser/Triple.h
+++ b/llvm/include/llvm/TargetParser/Triple.h
@@ -106,7 +106,8 @@ public:
     renderscript32, // 32-bit RenderScript
     renderscript64, // 64-bit RenderScript
     ve,             // NEC SX-Aurora Vector Engine
-    LastArchType = ve
+    simple,         // Simple target that provides barebones backend implementation
+    LastArchType = simple
   };
   enum SubArchType {
     NoSubArch,
@@ -955,6 +956,11 @@ public:
     return getArch() == Triple::ve;
   }
 
+  /// Tests whether the target is Simple
+  bool isSimple() const {
+    return getArch() == Triple::simple;
+  }
+
   /// Tests whether the target is wasm (32- and 64-bit).
   bool isWasm() const {
     return getArch() == Triple::wasm32 || getArch() == Triple::wasm64;
diff --git a/llvm/lib/BinaryFormat/ELF.cpp b/llvm/lib/BinaryFormat/ELF.cpp
index dc8f3051a1..8ac79fb1c7 100644
--- a/llvm/lib/BinaryFormat/ELF.cpp
+++ b/llvm/lib/BinaryFormat/ELF.cpp
@@ -194,6 +194,7 @@ uint16_t ELF::convertArchNameToEMachine(StringRef Arch) {
       .Case("amdgpu", EM_AMDGPU)
       .Case("riscv", EM_RISCV)
       .Case("lanai", EM_LANAI)
+      .Case("simple", EM_SIMPLE)
       .Case("bpf", EM_BPF)
       .Case("ve", EM_VE)
       .Case("csky", EM_CSKY)
@@ -556,6 +557,8 @@ StringRef ELF::convertEMachineToArchName(uint16_t EMachine) {
     return "riscv";
   case EM_LANAI:
     return "lanai";
+  case EM_SIMPLE:
+    return "simple";
   case EM_BPF:
     return "bpf";
   case EM_VE:
diff --git a/llvm/lib/Object/ELF.cpp b/llvm/lib/Object/ELF.cpp
index 0d1862e573..d6c2d4734e 100644
--- a/llvm/lib/Object/ELF.cpp
+++ b/llvm/lib/Object/ELF.cpp
@@ -95,6 +95,13 @@ StringRef llvm::object::getELFRelocationTypeName(uint32_t Machine,
       break;
     }
     break;
+case ELF::EM_SIMPLE:
+    switch (Type) {
+#include "llvm/BinaryFormat/ELFRelocs/Simple.def"
+    default:
+      break;
+    }
+    break;
   case ELF::EM_PPC:
     switch (Type) {
 #include "llvm/BinaryFormat/ELFRelocs/PowerPC.def"
@@ -211,6 +218,8 @@ uint32_t llvm::object::getELFRelativeRelocationType(uint32_t Machine) {
     return ELF::R_HEX_RELATIVE;
   case ELF::EM_LANAI:
     break;
+  case ELF::EM_SIMPLE:
+    break;
   case ELF::EM_PPC:
     break;
   case ELF::EM_PPC64:
diff --git a/llvm/lib/Object/RelocationResolver.cpp b/llvm/lib/Object/RelocationResolver.cpp
index 03ac592895..c0cb93497e 100644
--- a/llvm/lib/Object/RelocationResolver.cpp
+++ b/llvm/lib/Object/RelocationResolver.cpp
@@ -391,6 +391,17 @@ static uint64_t resolveLanai(uint64_t Type, uint64_t Offset, uint64_t S,
   llvm_unreachable("Invalid relocation type");
 }
 
+static bool supportsSimple(uint64_t Type) {
+  return Type == ELF::R_SIMPLE_NONE;
+}
+
+static uint64_t resolveSimple(uint64_t Type, uint64_t Offset, uint64_t S,
+                             uint64_t /*LocData*/, int64_t Addend) {
+  if (Type == ELF::R_SIMPLE_NONE)
+    return S + Addend;
+  llvm_unreachable("Invalid relocation type");
+}
+
 static bool supportsMips32(uint64_t Type) {
   switch (Type) {
   case ELF::R_MIPS_32:
@@ -825,6 +836,8 @@ getRelocationResolver(const ObjectFile &Obj) {
       return {supportsAVR, resolveAVR};
     case Triple::lanai:
       return {supportsLanai, resolveLanai};
+    case Triple::simple:
+      return {supportsSimple, resolveSimple};
     case Triple::loongarch32:
       return {supportsLoongArch, resolveLoongArch};
     case Triple::mipsel:
diff --git a/llvm/lib/ObjectYAML/ELFYAML.cpp b/llvm/lib/ObjectYAML/ELFYAML.cpp
index e92c61d810..44283899db 100644
--- a/llvm/lib/ObjectYAML/ELFYAML.cpp
+++ b/llvm/lib/ObjectYAML/ELFYAML.cpp
@@ -351,6 +351,7 @@ void ScalarEnumerationTraits<ELFYAML::ELF_EM>::enumeration(
   ECase(EM_AMDGPU);
   ECase(EM_RISCV);
   ECase(EM_LANAI);
+  ECase(EM_SIMPLE);
   ECase(EM_BPF);
   ECase(EM_VE);
   ECase(EM_CSKY);
@@ -891,6 +892,9 @@ void ScalarEnumerationTraits<ELFYAML::ELF_REL>::enumeration(
   case ELF::EM_LANAI:
 #include "llvm/BinaryFormat/ELFRelocs/Lanai.def"
     break;
+  case ELF::EM_SIMPLE:
+#include "llvm/BinaryFormat/ELFRelocs/Simple.def"
+    break;
   case ELF::EM_AMDGPU:
 #include "llvm/BinaryFormat/ELFRelocs/AMDGPU.def"
     break;
diff --git a/llvm/lib/TargetParser/Triple.cpp b/llvm/lib/TargetParser/Triple.cpp
index a3d6a06af9..fea12b0609 100644
--- a/llvm/lib/TargetParser/Triple.cpp
+++ b/llvm/lib/TargetParser/Triple.cpp
@@ -43,6 +43,7 @@ StringRef Triple::getArchTypeName(ArchType Kind) {
   case hsail:          return "hsail";
   case kalimba:        return "kalimba";
   case lanai:          return "lanai";
+  case simple:         return "simple";
   case le32:           return "le32";
   case le64:           return "le64";
   case loongarch32:    return "loongarch32";
@@ -159,6 +160,7 @@ StringRef Triple::getArchTypePrefix(ArchType Kind) {
 
   case kalimba:     return "kalimba";
   case lanai:       return "lanai";
+  case simple:      return "simple";
   case shave:       return "shave";
   case wasm32:
   case wasm64:      return "wasm";
@@ -385,6 +387,7 @@ Triple::ArchType Triple::getArchTypeForLLVMName(StringRef Name) {
     .Case("spirv64", spirv64)
     .Case("kalimba", kalimba)
     .Case("lanai", lanai)
+    .Case("simple", simple)
     .Case("shave", shave)
     .Case("wasm32", wasm32)
     .Case("wasm64", wasm64)
@@ -527,6 +530,7 @@ static Triple::ArchType parseArch(StringRef ArchName) {
            "spirv64v1.3", "spirv64v1.4", "spirv64v1.5", Triple::spirv64)
     .StartsWith("kalimba", Triple::kalimba)
     .Case("lanai", Triple::lanai)
+    .Case("simple", Triple::simple)
     .Case("renderscript32", Triple::renderscript32)
     .Case("renderscript64", Triple::renderscript64)
     .Case("shave", Triple::shave)
@@ -821,6 +825,7 @@ static Triple::ObjectFormatType getDefaultFormat(const Triple &T) {
   case Triple::hsail:
   case Triple::kalimba:
   case Triple::lanai:
+  case Triple::simple:
   case Triple::le32:
   case Triple::le64:
   case Triple::loongarch32:
@@ -1409,6 +1414,7 @@ static unsigned getArchPointerBitWidth(llvm::Triple::ArchType Arch) {
   case llvm::Triple::hsail:
   case llvm::Triple::kalimba:
   case llvm::Triple::lanai:
+  case llvm::Triple::simple:
   case llvm::Triple::le32:
   case llvm::Triple::loongarch32:
   case llvm::Triple::m68k:
@@ -1500,6 +1506,7 @@ Triple Triple::get32BitArchVariant() const {
   case Triple::hsail:
   case Triple::kalimba:
   case Triple::lanai:
+  case Triple::simple:
   case Triple::le32:
   case Triple::loongarch32:
   case Triple::m68k:
@@ -1566,6 +1573,7 @@ Triple Triple::get64BitArchVariant() const {
   case Triple::hexagon:
   case Triple::kalimba:
   case Triple::lanai:
+  case Triple::simple:
   case Triple::m68k:
   case Triple::msp430:
   case Triple::r600:
@@ -1710,6 +1718,7 @@ Triple Triple::getLittleEndianArchVariant() const {
   switch (getArch()) {
   case Triple::UnknownArch:
   case Triple::lanai:
+  case Triple::simple:
   case Triple::sparcv9:
   case Triple::systemz:
   case Triple::m68k:
