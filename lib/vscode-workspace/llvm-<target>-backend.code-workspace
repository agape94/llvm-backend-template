{
    "folders": [
        {
            "path": "."
        }
    ],
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools-extension-pack"
        ]
    },
    "settings": {},
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "CMake: configure",
                "type": "shell",
                "command": "cmake",
                "args": [
                    "-S",
                    "${workspaceFolder}/llvm",
                    "-B",
                    "${workspaceFolder}/build_vscode",
                    "-G",
                    "Ninja",
                    "-DCMAKE_BUILD_TYPE=\"RelWithDebInfo\"",
                    "-DLLVM_ENABLE_PROJECTS=\"clang;lld\"",
                    "-DCMAKE_EXPORT_COMPILE_COMMANDS=\"1\"",
                    "-DBUILD_SHARED_LIBS=\"Off\"",
                    "-DLLVM_BUILD_LLVM_DYLIB=\"On\"",
                    "-DLLVM_LINK_LLVM_DYLIB=\"On\"",
                    "-DCLANG_LINK_CLANG_DYLIB=\"On\"",
                    "-DLLVM_TARGETS_TO_BUILD=\"\"",
                    "-DLLVM_EXPERIMENTAL_TARGETS_TO_BUILD=\"<Target>\"",
                    "-DLLVM_ENABLE_IDE=\"On\"",
                    "-DLLVM_ENABLE_ASSERTIONS=\"On\"",
                    "-DLLVM_BUILD_EXAMPLES=\"On\"",
                    "-DLLVM_LIT_ARGS=\"-v --xunit-xml-output test-results.xml\"",
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "problemMatcher": []
            },
            {
                "label": "Ninja: build",
                "type": "shell",
                "command": "ninja",
                "args": [],
                "options": {
                    "cwd": "${workspaceFolder}/build_vscode"
                },
                "problemMatcher": [],
                "dependsOn": "CMake: configure"
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "clang: build the current C file",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/build-vscode/bin/clang",
                "args": [
                    "--target=<target>",
                    "${fileBasename}",
                    "-o",
                    "${fileBasename}.s",
                    "--debug"
                ],
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ],
                "cwd": "${fileDirname}",
                "preLaunchTask": "Ninja: build"
            },
            {
                "name": "llc: build the current LLVM IR file",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/build-vscode/bin/llc",
                "args": [
                    "--march=<target>",
                    "${fileBasename}",
                    "-o",
                    "${fileBasename}.s",
                    "--debug"
                ],
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ],
                "cwd": "${fileDirname}",
                "preLaunchTask": "Ninja: build"
            },
            {
                "name": "llvm-mc: Assemble the llvm-mc-test.s file",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/build-vscode/bin/llvm-mc",
                "args": [
                    // Set the path to the file you want to assemble
                    "${workspaceFolder}/tests/llvm-mc-test.s",
                    "--triple=<target>",
                    "--show-encoding",
                    "--debug"
                ],
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ],
                "cwd": "${fileDirname}",
                "preLaunchTask": "Ninja: build"
            }
        ]
    }
}