From 12c2d175a94fe075c620f0b162aa039dd8c5cc0d Mon Sep 17 00:00:00 2001
From: Alexandru Agape <alexandru.agape@student.tugraz.at>
Date: Fri, 19 Jan 2024 11:45:16 +0100
Subject: [PATCH] Add Prototype 8-bit target to the LLVM build system

---
 llvm/include/llvm/BinaryFormat/ELF.h                |  6 ++++++
 llvm/include/llvm/BinaryFormat/ELFRelocs/Prototype.def |  6 ++++++
 llvm/include/llvm/Object/ELFObjectFile.h            |  4 ++++
 llvm/include/llvm/TargetParser/Triple.h             |  6 ++++++
 llvm/lib/BinaryFormat/ELF.cpp                       |  3 +++
 llvm/lib/Object/ELF.cpp                             |  9 +++++++++
 llvm/lib/Object/RelocationResolver.cpp              | 13 +++++++++++++
 llvm/lib/ObjectYAML/ELFYAML.cpp                     |  4 ++++
 llvm/lib/TargetParser/Triple.cpp                    |  9 +++++++++
 9 files changed, 60 insertions(+)
 create mode 100644 llvm/include/llvm/BinaryFormat/ELFRelocs/Prototype.def

diff --git a/llvm/include/llvm/BinaryFormat/ELF.h b/llvm/include/llvm/BinaryFormat/ELF.h
index f5a7cdb38..8db4ebfe0 100644
--- a/llvm/include/llvm/BinaryFormat/ELF.h
+++ b/llvm/include/llvm/BinaryFormat/ELF.h
@@ -157,7 +157,6 @@ enum {
   EM_ALPHA = 41,         // DEC Alpha
   EM_SH = 42,            // Hitachi SH
   EM_SPARCV9 = 43,       // SPARC V9
-  EM_TRICORE = 44,       // Siemens TriCore
   EM_ARC = 45,           // Argonaut RISC Core
   EM_H8_300 = 46,        // Hitachi H8/300
   EM_H8_300H = 47,       // Hitachi H8/300H
@@ -320,6 +320,7 @@ enum {
   EM_VE = 251,            // NEC SX-Aurora VE
   EM_CSKY = 252,          // C-SKY 32-bit processor
   EM_LOONGARCH = 258,     // LoongArch
+  EM_PROTOTYPE = 300,        // Prototype 8-bit
 };
 
 // Object file classes.
@@ -665,6 +666,11 @@ enum {
 #include "ELFRelocs/Lanai.def"
 };
 
+// ELF Relocation type for Prototype.
+enum {
+#include "ELFRelocs/Prototype.def"
+};
+
 // RISCV Specific e_flags
 enum : unsigned {
   EF_RISCV_RVC = 0x0001,
diff --git a/llvm/include/llvm/BinaryFormat/ELFRelocs/Prototype.def b/llvm/include/llvm/BinaryFormat/ELFRelocs/Prototype.def
new file mode 100644
index 000000000..1b5066f1c
--- /dev/null
+++ b/llvm/include/llvm/BinaryFormat/ELFRelocs/Prototype.def
@@ -0,0 +1,6 @@
+#ifndef ELF_RELOC
+#error "ELF_RELOC must be defined"
+#endif
+
+// No relocation
+ELF_RELOC(R_PROTOTYPE_NONE,        0)
\ No newline at end of file
diff --git a/llvm/include/llvm/Object/ELFObjectFile.h b/llvm/include/llvm/Object/ELFObjectFile.h
index f3016cc14..07570c528 100644
--- a/llvm/include/llvm/Object/ELFObjectFile.h
+++ b/llvm/include/llvm/Object/ELFObjectFile.h
@@ -1206,6 +1206,8 @@ StringRef ELFObjectFile<ELFT>::getFileFormatName() const {
       return "elf32-hexagon";
     case ELF::EM_LANAI:
       return "elf32-lanai";
+    case ELF::EM_PROTOTYPE:
+      return "elf32-prototype";
     case ELF::EM_MIPS:
       return "elf32-mips";
     case ELF::EM_MSP430:
@@ -1283,6 +1285,8 @@ template <class ELFT> Triple::ArchType ELFObjectFile<ELFT>::getArch() const {
     return Triple::hexagon;
   case ELF::EM_LANAI:
     return Triple::lanai;
+  case ELF::EM_PROTOTYPE:
+    return Triple::prototype;
   case ELF::EM_MIPS:
     switch (EF.getHeader().e_ident[ELF::EI_CLASS]) {
     case ELF::ELFCLASS32:
diff --git a/llvm/include/llvm/TargetParser/Triple.h b/llvm/include/llvm/TargetParser/Triple.h
index 79ccd644a..f78028326 100644
--- a/llvm/include/llvm/TargetParser/Triple.h
+++ b/llvm/include/llvm/TargetParser/Triple.h
@@ -101,6 +101,7 @@ public:
     kalimba,        // Kalimba: generic kalimba
     shave,          // SHAVE: Movidius vector VLIW processors
     lanai,          // Lanai: Lanai 32-bit
+    prototype,         // Prototype: Prototype 8-bit
     wasm32,         // WebAssembly with 32-bit pointers
     wasm64,         // WebAssembly with 64-bit pointers
     renderscript32, // 32-bit RenderScript
@@ -950,6 +951,11 @@ public:
     return getArch() == Triple::x86 || getArch() == Triple::x86_64;
   }
 
+  /// Tests whether the target is Prototype
+  bool isPrototype() const {
+    return getArch() == Triple::prototype;
+  }
+
   /// Tests whether the target is VE
   bool isVE() const {
     return getArch() == Triple::ve;
diff --git a/llvm/lib/BinaryFormat/ELF.cpp b/llvm/lib/BinaryFormat/ELF.cpp
index dc8f3051a..8ac79fb1c 100644
--- a/llvm/lib/BinaryFormat/ELF.cpp
+++ b/llvm/lib/BinaryFormat/ELF.cpp
@@ -44,7 +44,6 @@ uint16_t ELF::convertArchNameToEMachine(StringRef Arch) {
       .Case("alpha", EM_ALPHA)
       .Case("sh", EM_SH)
       .Case("sparcv9", EM_SPARCV9)
-      .Case("tricore", EM_TRICORE)
       .Case("arc", EM_ARC)
       .Case("h8_300", EM_H8_300)
       .Case("h8_300h", EM_H8_300H)
@@ -194,6 +194,7 @@ uint16_t ELF::convertArchNameToEMachine(StringRef Arch) {
       .Case("amdgpu", EM_AMDGPU)
       .Case("riscv", EM_RISCV)
       .Case("lanai", EM_LANAI)
+      .Case("prototype", EM_PROTOTYPE)
       .Case("bpf", EM_BPF)
       .Case("ve", EM_VE)
       .Case("csky", EM_CSKY)
@@ -259,8 +258,6 @@ StringRef ELF::convertEMachineToArchName(uint16_t EMachine) {
     return "sh";
   case EM_SPARCV9:
     return "sparcv9";
-  case EM_TRICORE:
-    return "tricore";
   case EM_ARC:
     return "arc";
   case EM_H8_300:
@@ -556,6 +557,8 @@ StringRef ELF::convertEMachineToArchName(uint16_t EMachine) {
     return "riscv";
   case EM_LANAI:
     return "lanai";
+  case EM_PROTOTYPE:
+    return "prototype";
   case EM_BPF:
     return "bpf";
   case EM_VE:
diff --git a/llvm/lib/Object/ELF.cpp b/llvm/lib/Object/ELF.cpp
index 0d1862e57..85daee7f2 100644
--- a/llvm/lib/Object/ELF.cpp
+++ b/llvm/lib/Object/ELF.cpp
@@ -95,6 +95,13 @@ StringRef llvm::object::getELFRelocationTypeName(uint32_t Machine,
       break;
     }
     break;
+  case ELF::EM_PROTOTYPE:
+    switch (Type) {
+#include "llvm/BinaryFormat/ELFRelocs/Prototype.def"
+    default:
+      break;
+    }
+    break;
   case ELF::EM_PPC:
     switch (Type) {
 #include "llvm/BinaryFormat/ELFRelocs/PowerPC.def"
@@ -211,6 +218,8 @@ uint32_t llvm::object::getELFRelativeRelocationType(uint32_t Machine) {
     return ELF::R_HEX_RELATIVE;
   case ELF::EM_LANAI:
     break;
+  case ELF::EM_PROTOTYPE:
+    break;
   case ELF::EM_PPC:
     break;
   case ELF::EM_PPC64:
diff --git a/llvm/lib/Object/RelocationResolver.cpp b/llvm/lib/Object/RelocationResolver.cpp
index 03ac59289..c0cb93497 100644
--- a/llvm/lib/Object/RelocationResolver.cpp
+++ b/llvm/lib/Object/RelocationResolver.cpp
@@ -391,6 +391,17 @@ static uint64_t resolveLanai(uint64_t Type, uint64_t Offset, uint64_t S,
   llvm_unreachable("Invalid relocation type");
 }
 
+static bool supportsPrototype(uint64_t Type) {
+  return Type == ELF::R_PROTOTYPE_NONE;
+}
+
+static uint64_t resolvePrototype(uint64_t Type, uint64_t Offset, uint64_t S,
+                             uint64_t /*LocData*/, int64_t Addend) {
+  if (Type == ELF::R_PROTOTYPE_NONE)
+    return S + Addend;
+  llvm_unreachable("Invalid relocation type");
+}
+
 static bool supportsMips32(uint64_t Type) {
   switch (Type) {
   case ELF::R_MIPS_32:
@@ -825,6 +836,8 @@ getRelocationResolver(const ObjectFile &Obj) {
       return {supportsAVR, resolveAVR};
     case Triple::lanai:
       return {supportsLanai, resolveLanai};
+    case Triple::prototype:
+      return {supportsPrototype, resolvePrototype};
     case Triple::loongarch32:
       return {supportsLoongArch, resolveLoongArch};
     case Triple::mipsel:
diff --git a/llvm/lib/ObjectYAML/ELFYAML.cpp b/llvm/lib/ObjectYAML/ELFYAML.cpp
index e92c61d81..44283899d 100644
--- a/llvm/lib/ObjectYAML/ELFYAML.cpp
+++ b/llvm/lib/ObjectYAML/ELFYAML.cpp
@@ -219,7 +219,6 @@ void ScalarEnumerationTraits<ELFYAML::ELF_EM>::enumeration(
   ECase(EM_ALPHA);
   ECase(EM_SH);
   ECase(EM_SPARCV9);
-  ECase(EM_TRICORE);
   ECase(EM_ARC);
   ECase(EM_H8_300);
   ECase(EM_H8_300H);
@@ -351,6 +351,7 @@ void ScalarEnumerationTraits<ELFYAML::ELF_EM>::enumeration(
   ECase(EM_AMDGPU);
   ECase(EM_RISCV);
   ECase(EM_LANAI);
+  ECase(EM_PROTOTYPE);
   ECase(EM_BPF);
   ECase(EM_VE);
   ECase(EM_CSKY);
@@ -891,6 +892,9 @@ void ScalarEnumerationTraits<ELFYAML::ELF_REL>::enumeration(
   case ELF::EM_LANAI:
 #include "llvm/BinaryFormat/ELFRelocs/Lanai.def"
     break;
+  case ELF::EM_PROTOTYPE:
+#include "llvm/BinaryFormat/ELFRelocs/Prototype.def"
+    break;
   case ELF::EM_AMDGPU:
 #include "llvm/BinaryFormat/ELFRelocs/AMDGPU.def"
     break;
diff --git a/llvm/lib/TargetParser/Triple.cpp b/llvm/lib/TargetParser/Triple.cpp
index a3d6a06af..d11df6806 100644
--- a/llvm/lib/TargetParser/Triple.cpp
+++ b/llvm/lib/TargetParser/Triple.cpp
@@ -43,6 +43,7 @@ StringRef Triple::getArchTypeName(ArchType Kind) {
   case hsail:          return "hsail";
   case kalimba:        return "kalimba";
   case lanai:          return "lanai";
+  case prototype:         return "prototype";
   case le32:           return "le32";
   case le64:           return "le64";
   case loongarch32:    return "loongarch32";
@@ -159,6 +160,7 @@ StringRef Triple::getArchTypePrefix(ArchType Kind) {
 
   case kalimba:     return "kalimba";
   case lanai:       return "lanai";
+  case prototype:      return "prototype";
   case shave:       return "shave";
   case wasm32:
   case wasm64:      return "wasm";
@@ -385,6 +387,7 @@ Triple::ArchType Triple::getArchTypeForLLVMName(StringRef Name) {
     .Case("spirv64", spirv64)
     .Case("kalimba", kalimba)
     .Case("lanai", lanai)
+    .Case("prototype", prototype)
     .Case("shave", shave)
     .Case("wasm32", wasm32)
     .Case("wasm64", wasm64)
@@ -527,6 +530,7 @@ static Triple::ArchType parseArch(StringRef ArchName) {
            "spirv64v1.3", "spirv64v1.4", "spirv64v1.5", Triple::spirv64)
     .StartsWith("kalimba", Triple::kalimba)
     .Case("lanai", Triple::lanai)
+    .Case("prototype", Triple::prototype)
     .Case("renderscript32", Triple::renderscript32)
     .Case("renderscript64", Triple::renderscript64)
     .Case("shave", Triple::shave)
@@ -821,6 +825,7 @@ static Triple::ObjectFormatType getDefaultFormat(const Triple &T) {
   case Triple::hsail:
   case Triple::kalimba:
   case Triple::lanai:
+  case Triple::prototype:
   case Triple::le32:
   case Triple::le64:
   case Triple::loongarch32:
@@ -1396,6 +1401,7 @@ static unsigned getArchPointerBitWidth(llvm::Triple::ArchType Arch) {
 
   case llvm::Triple::avr:
   case llvm::Triple::msp430:
+  case llvm::Triple::prototype:
     return 16;
 
   case llvm::Triple::aarch64_32:
@@ -1484,6 +1490,7 @@ Triple Triple::get32BitArchVariant() const {
   case Triple::bpfeb:
   case Triple::bpfel:
   case Triple::msp430:
+  case Triple::prototype:
   case Triple::systemz:
   case Triple::ve:
     T.setArch(UnknownArch);
@@ -1568,6 +1575,7 @@ Triple Triple::get64BitArchVariant() const {
   case Triple::lanai:
   case Triple::m68k:
   case Triple::msp430:
+  case Triple::prototype:
   case Triple::r600:
   case Triple::shave:
   case Triple::sparcel:
